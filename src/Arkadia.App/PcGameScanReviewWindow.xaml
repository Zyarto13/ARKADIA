<Window x:Class="Arkadia.App.PcGameScanReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Arkadia.App.Localization"
        Title="{Binding [Games.ScanReview.Title], Source={x:Static loc:LocalizationManager.Instance}}"
        Width="620"
        Height="560"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{Binding [Games.ScanReview.Description], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding ScanSummary}"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}"
                                  Margin="0,5"
                                  AutomationProperties.Name="{Binding Title}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ExecutablePath}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="{Binding [Games.ScanReview.Cancel], Source={x:Static loc:LocalizationManager.Instance}}"
                    Style="{StaticResource SurfaceButtonStyle}"
                    Padding="16,9"
                    IsCancel="True"
                    DockPanel.Dock="Right" />
            <Button Content="{Binding [Games.ScanReview.Add], Source={x:Static loc:LocalizationManager.Instance}}"
                    Style="{StaticResource SurfaceButtonStyle}"
                    Padding="16,9"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="AddSelected_Click"
                    DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
