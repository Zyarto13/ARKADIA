<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF07130F" Offset="0" />
        <GradientStop Color="#FF0B1C16" Offset="0.56" />
        <GradientStop Color="#FF0A2119" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF10231B" />
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#FF0D1D16" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF183126" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF294A3A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF0F7F3" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA2B9AD" />
    <Color x:Key="AccentColor">#FF45D6A0</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF65E6A2" />
</ResourceDictionary>
