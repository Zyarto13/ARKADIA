<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF090D12" Offset="0" />
        <GradientStop Color="#FF111820" Offset="0.58" />
        <GradientStop Color="#FF0C1619" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF151D24" />
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#FF121A21" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF202B32" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF34434A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F6F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9DABA8" />
    <Color x:Key="AccentColor">#FF8DAAFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF4ED69B" />
</ResourceDictionary>
