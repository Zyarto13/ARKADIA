<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF030407" Offset="0" />
        <GradientStop Color="#FF10131D" Offset="0.58" />
        <GradientStop Color="#FF050609" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF151924" Offset="0" />
        <GradientStop Color="#FF0B0D12" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ComboBoxPopupBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF171A24" Offset="0" />
        <GradientStop Color="#FF0B0D12" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF222B3D" Offset="0" />
        <GradientStop Color="#FF111925" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#303C4C68" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F5FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA3B5" />
    <Color x:Key="AccentColor">#FF00D2FF</Color>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF00D2FF" Offset="0" />
        <GradientStop Color="#FF7C7BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2ECC71" Offset="0" />
        <GradientStop Color="#FF93DC63" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
