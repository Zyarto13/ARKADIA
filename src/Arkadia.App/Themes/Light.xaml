<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF5F7FC" Offset="0" />
        <GradientStop Color="#FFE6EEF5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFDFEFF" Offset="0" />
        <GradientStop Color="#FFE9F2F6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ComboBoxPopupBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFE8F0F6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFDCEEF0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#300E2055" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF171A27" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF606A7D" />
    <Color x:Key="AccentColor">#FF3A73D9</Color>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3A73D9" Offset="0" />
        <GradientStop Color="#FF21B9C1" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1D9D6C" Offset="0" />
        <GradientStop Color="#FF75C841" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
