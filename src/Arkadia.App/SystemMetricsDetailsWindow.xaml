<Window x:Class="Arkadia.App.SystemMetricsDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Arkadia.App.Localization"
        Title="{Binding [System.Details.Title], Source={x:Static loc:LocalizationManager.Instance}}"
        Width="720"
        Height="760"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="{Binding [System.Details.Title], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,18" />
            <UniformGrid Columns="2" Margin="0,0,0,18">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="{Binding [System.Details.Cpu], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SystemMetricsCpuText}"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="8,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding [System.Details.Memory], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SystemMetricsUsedMemoryText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="{Binding SystemMetricsAvailableMemoryText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SystemMetricsTotalMemoryText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,8,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [System.Details.Gpu], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SystemMetricsGpuText}"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Margin="8,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [System.Details.GpuMemory], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SystemMetricsGpuMemoryText}"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{Binding [System.Details.Cores], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding SystemCoreMetrics}"
                          Margin="0,0,0,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10,7"
                                Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="{Binding UsageText}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding [System.Details.History], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="6,0,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [System.Details.Time], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding [System.Details.Cpu], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding [System.Details.Memory], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding [System.Details.Gpu], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="270"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SystemMetricsHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CapturedAtText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" />
                                        <TextBlock Grid.Column="2" Text="{Binding MemoryText}" />
                                        <TextBlock Grid.Column="3" Text="{Binding GpuText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
