                                                      MinWidth="150"
                                                      Margin="0,0,8,0"
                                                      ToolTip="{Binding [Sound.Profiles], Source={x:Static loc:LocalizationManager.Instance}}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                <Button Command="{Binding ApplyAudioProfileCommand}"
                                                        IsEnabled="{Binding CanApplyAudioProfile}"
                                                        Style="{StaticResource SurfaceButtonStyle}"
                                                        Padding="12,7"
                                                        Margin="0,0,8,0"
                                                        Content="{Binding [Sound.ApplyProfile], Source={x:Static loc:LocalizationManager.Instance}}" />
                                                <Button Command="{Binding DeleteAudioProfileCommand}"
                                                        IsEnabled="{Binding CanApplyAudioProfile}"
                                                        Style="{StaticResource SurfaceButtonStyle}"
                                                        Padding="12,7"
                                                        Content="{Binding [Sound.DeleteProfile], Source={x:Static loc:LocalizationManager.Instance}}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding [Sound.AppSessions], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AudioSessionsStatusText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,0" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AudioSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#12FFFFFF"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30"
                                                                Height="30"
                                                                CornerRadius="8"
                                                                Background="#16FFFFFF"
                                                                VerticalAlignment="Center">
                                                            <Grid>
                                                                <Image x:Name="SessionIcon"
                                                                       Source="{Binding Icon}"
                                                                       Width="22"
                                                                       Height="22"
                                                                       Stretch="Uniform"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center" />
                                                                <TextBlock x:Name="SessionIconFallback"
                                                                           Text="◉"
                                                                           FontSize="16"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           Visibility="Collapsed" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="Medium"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DeviceName}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       FontSize="10"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Slider Minimum="0"
                                                                    Maximum="100"
                                                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Width="220"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="{Binding [Sound.AppVolume], Source={x:Static loc:LocalizationManager.Instance}}" />
                                                            <TextBlock Text="{Binding VolumePercent, StringFormat={}{0}%}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0" />
                                                        </StackPanel>
                                                        <ProgressBar Minimum="0"
                                                                     Maximum="1"
                                                                     Value="{Binding PeakLevel, Mode=OneWay}"
                                                                     Height="5"
                                                                     Margin="0,5,0,0"
                                                                     AutomationProperties.Name="{Binding [Sound.AudioLevel], Source={x:Static loc:LocalizationManager.Instance}}" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2"
                                                              Content="{Binding [Sound.Mute], Source={x:Static loc:LocalizationManager.Instance}}"
                                                              IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter TargetName="SessionIcon" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="SessionIconFallback" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsComingSoon, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="28"
                                Margin="0,0,12,12">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        MaxWidth="520">
                                <TextBlock Text="{Binding CurrentPageTitle}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ComingSoonText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="{Binding LaunchMessage}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="12"
                       HorizontalAlignment="Right"
                       Margin="0,8,12,0" />
        </Grid>
    </Grid>
</Window>
