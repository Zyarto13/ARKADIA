<Window x:Class="Arkadia.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Arkadia.App.Controls"
        xmlns:icons="clr-namespace:Arkadia.App.Icons"
        xmlns:loc="clr-namespace:Arkadia.App.Localization"
        Title="ARKADIA"
        Icon="pack://application:,,,/Assets/arkadia.ico"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        Closing="MainWindow_Closing"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectPageCommand}" CommandParameter="Home" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectPageCommand}" CommandParameter="Games" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectPageCommand}" CommandParameter="Achievements" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SelectPageCommand}" CommandParameter="Sound" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SelectPageCommand}" CommandParameter="Shortcuts" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding SelectPageCommand}" CommandParameter="Settings" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#16FFFFFF"
                BorderBrush="#24FFFFFF"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="270" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Style="{StaticResource BrandButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding SelectPageCommand}"
                        CommandParameter="Home"
                        AutomationProperties.Name="ARKADIA">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 3,21 L 12,3 L 21,21"
                              Fill="Transparent"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="2.8"
                              StrokeLineJoin="Miter"
                              StrokeStartLineCap="Flat"
                              StrokeEndLineCap="Flat"
                              Width="23"
                              Height="23"
                              Stretch="Uniform"
                              Margin="0,0,12,0" />
                        <TextBlock Text="ARKADIA"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationItems}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}"
                                        Tag="{Binding IsSelected}"
                                        Style="{StaticResource NavigationButtonStyle}"
                                        ToolTip="{Binding Title}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{Binding Icon}"
                                              Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="10,4,10,8"
                        Padding="9"
                        CornerRadius="16"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="1,0,1,7">
                            <TextBlock Text="{Binding SelectedMusicService}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right"
                                    Width="25"
                                    Height="24"
                                    Padding="4"
                                    Style="{StaticResource SurfaceButtonStyle}"
                                    Command="{Binding OpenMusicAppCommand}"
                                    ToolTip="{Binding [Home.MediaControl.Open], Source={x:Static loc:LocalizationManager.Instance}}"
                                    AutomationProperties.Name="{Binding [Home.MediaControl.Open], Source={x:Static loc:LocalizationManager.Instance}}">
                                <TextBlock Text="↗"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                        <controls:RoundedClipBorder Height="98"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource CardHoverBrush}"
                                                    ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding CurrentTrackArtwork}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasCurrentTrack, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Path Data="M 4,8 L 10,3 L 16,8 L 16,16 L 4,16 Z M 8,16 L 8,11 L 12,11 L 12,16"
                                      Fill="{DynamicResource AccentBrush}"
                                      Width="22"
                                      Height="22"
                                      Stretch="Uniform"
                                      Opacity="0.62"
                                      Visibility="{Binding HasCurrentTrack, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                        </controls:RoundedClipBorder>
                        <TextBlock Text="{Binding MusicPlayerTrackTitle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="1,7,1,0" />
                        <TextBlock Text="{Binding MusicPlayerTrackArtist}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="1,1,1,0" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0">
                            <Button Width="32"
                                    Height="30"
                                    Padding="5"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource SurfaceButtonStyle}"
                                    Command="{Binding PlayPreviousMusicTrackCommand}"
                                    ToolTip="{Binding [Home.MediaControl.Previous], Source={x:Static loc:LocalizationManager.Instance}}"
                                    AutomationProperties.Name="{Binding [Home.MediaControl.Previous], Source={x:Static loc:LocalizationManager.Instance}}">
                                <Path Data="M 3,2 H 5 V 14 H 3 Z M 15,2 L 6,8 L 15,14 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform" />
                            </Button>
                            <Button Width="38"
                                    Height="30"
                                    Padding="5"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource SurfaceButtonStyle}"
                                    Command="{Binding ToggleMusicPlaybackCommand}"
                                    ToolTip="{Binding MusicPlaybackTooltip}"
                                    AutomationProperties.Name="{Binding MusicPlaybackTooltip}">
                                <Path Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M 3,2 L 14,8 L 3,14 Z" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMusicPlaying}" Value="True">
                                                    <Setter Property="Data" Value="M 3,2 H 6 V 14 H 3 Z M 10,2 H 13 V 14 H 10 Z" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Button Width="32"
                                    Height="30"
                                    Padding="5"
                                    Style="{StaticResource SurfaceButtonStyle}"
                                    Command="{Binding PlayNextMusicTrackCommand}"
                                    ToolTip="{Binding [Home.MediaControl.Next], Source={x:Static loc:LocalizationManager.Instance}}"
                                    AutomationProperties.Name="{Binding [Home.MediaControl.Next], Source={x:Static loc:LocalizationManager.Instance}}">
                                <Path Data="M 13,2 H 15 V 14 H 13 Z M 1,2 L 10,8 L 1,14 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource MusicVolumeSliderStyle}"
                                    Minimum="0"
                                    Maximum="100"
                                    SmallChange="1"
                                    LargeChange="5"
                                    Value="{Binding MusicVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanAdjustMusicVolume}"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding [Home.MediaControl.Volume], Source={x:Static loc:LocalizationManager.Instance}}"
                                    AutomationProperties.Name="{Binding [Home.MediaControl.Volume], Source={x:Static loc:LocalizationManager.Instance}}" />
                            <Border Grid.Column="1"
                                    Width="36"
                                    Height="26"
                                    CornerRadius="7"
                                    Background="{DynamicResource CardHoverBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Margin="2,0,0,0">
                                <TextBox Width="34"
                                         Height="24"
                                         MaxLength="3"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="1,0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Text="{Binding MusicVolumePercent, Mode=OneWay}"
                                         IsEnabled="{Binding CanAdjustMusicVolume}"
                                         PreviewTextInput="MusicVolumePercent_PreviewTextInput"
                                         LostFocus="MusicVolumePercent_LostFocus"
                                         KeyDown="MusicVolumePercent_KeyDown"
                                         DataObject.Pasting="MusicVolumePercent_Pasting"
                                         ToolTip="{Binding [Home.MediaControl.Volume], Source={x:Static loc:LocalizationManager.Instance}}"
                                         AutomationProperties.Name="{Binding [Home.MediaControl.Volume], Source={x:Static loc:LocalizationManager.Instance}}" />
                            </Border>
                            <Button Grid.Column="2"
                                    Width="28"
                                    Height="26"
                                    Padding="4"
                                    Margin="3,0,0,0"
                                    Style="{StaticResource SurfaceButtonStyle}"
                                    Command="{Binding ToggleMusicMuteCommand}"
                                    IsEnabled="{Binding CanAdjustMusicVolume}"
                                    ToolTip="{Binding MusicMuteTooltip}"
                                    AutomationProperties.Name="{Binding MusicMuteTooltip}">
                                <Grid>
                                    <Path Data="M 2,7 H 5 L 10,3 V 13 L 5,9 H 2 Z M 12,6 A 3,3 0 0 1 12,10"
                                          Stroke="{DynamicResource TextPrimaryBrush}"
                                          StrokeThickness="1.2"
                                          Width="16"
                                          Height="16"
                                          Stretch="Uniform" />
                                    <Path Data="M 3,3 L 13,13"
                                          Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.8"
                                          Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          Visibility="Collapsed">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMusicMuted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Grid.Row="3"
                        Command="{Binding SelectPageCommand}"
                        CommandParameter="Settings"
                        Tag="{Binding IsSettingsSelected}"
                        Style="{StaticResource NavigationButtonStyle}"
                        ToolTip="{Binding [Navigation.Settings], Source={x:Static loc:LocalizationManager.Instance}}"
                        AutomationProperties.Name="{Binding [Navigation.Settings], Source={x:Static loc:LocalizationManager.Instance}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{x:Static icons:IconCatalog.Settings}"
                              Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Margin="0,0,14,0" />
                        <TextBlock Text="{Binding [Navigation.Settings], Source={x:Static loc:LocalizationManager.Instance}}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,0,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,22,0">
                    <Ellipse Width="7"
                             Height="7"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectivityText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding ClockText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0" />
                <Button x:Name="SettingsQuickAccessButton"
                        Grid.Column="3"
                        Width="40"
                        Height="40"
                        Padding="8"
                        Margin="0,0,10,0"
                        Style="{StaticResource NavigationButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding SelectPageCommand}"
                        CommandParameter="Settings"
                        Tag="{Binding IsSettingsSelected}"
                        ToolTip="{Binding [Navigation.Settings], Source={x:Static loc:LocalizationManager.Instance}}"
                        AutomationProperties.Name="{Binding [Navigation.Settings], Source={x:Static loc:LocalizationManager.Instance}}">
                    <Path Data="{x:Static icons:IconCatalog.Settings}"
                          Width="18"
                          Height="18"
                          Stretch="Uniform"
                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                </Button>
                <Button x:Name="UpdateActionButton"
                        Grid.Column="4"
                        Width="40"
                        Height="40"
                        Padding="4"
                        Margin="0,0,10,0"
                        Style="{StaticResource SurfaceButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding UpdateActionCommand}"
                        ToolTip="{Binding UpdateActionTooltip}"
                        AutomationProperties.Name="{Binding UpdateActionTooltip}">
                    <Grid Width="28" Height="28">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="{DynamicResource CardHoverBrush}" />
                        <Path Width="15"
                              Height="15"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.5">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M 2,7 A 5,5 0 1 1 3.5,12 M 2,3 V 7 H 6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdateAvailable}" Value="True">
                                            <Setter Property="Data" Value="M 8,1 V 9 M 5,6 L 8,9 L 11,6 M 3,10 V 13 H 13 V 10" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Ellipse Width="8"
                                 Height="8"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Fill="{DynamicResource AccentBrush}"
                                 Stroke="{DynamicResource WindowBackgroundBrush}"
                                 StrokeThickness="1"
                                 Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Button>
                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="MinimizeWindowButton"
                            Width="38"
                            Height="36"
                            Padding="8"
                            Margin="0,0,4,0"
                            Style="{StaticResource SurfaceButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeWindow_Click"
                            ToolTip="{Binding [Window.Minimize], Source={x:Static loc:LocalizationManager.Instance}}"
                            AutomationProperties.Name="{Binding [Window.Minimize], Source={x:Static loc:LocalizationManager.Instance}}">
                        <Path Data="M 2,7 H 14"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.4"
                              Stretch="Uniform"
                              Width="14"
                              Height="14" />
                    </Button>
                    <Button x:Name="MaximizeWindowButton"
                            Width="38"
                            Height="36"
                            Padding="8"
                            Margin="0,0,4,0"
                            Style="{StaticResource SurfaceButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="ToggleMaximizeWindow_Click"
                            ToolTip="{Binding [Window.Maximize], Source={x:Static loc:LocalizationManager.Instance}}"
                            AutomationProperties.Name="{Binding [Window.Maximize], Source={x:Static loc:LocalizationManager.Instance}}">
                        <Path Stretch="Uniform"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.2"
                              Width="14"
                              Height="14">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M 2,2 H 14 V 14 H 2 Z" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Data" Value="M 5,2 H 14 V 11 H 5 Z M 2,5 V 14 H 11" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button x:Name="CloseWindowButton"
                            Width="38"
                            Height="36"
                            Padding="8"
                            Style="{StaticResource SurfaceButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseWindow_Click"
                            ToolTip="{Binding [Window.Close], Source={x:Static loc:LocalizationManager.Instance}}"
                            AutomationProperties.Name="{Binding [Window.Close], Source={x:Static loc:LocalizationManager.Instance}}">
                        <Path Data="M 3,3 L 13,13 M 13,3 L 3,13"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.4"
                              Stretch="Uniform"
                              Width="14"
                              Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,18,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="29"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentPageSubtitle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding [Home.Layout.DragHint], Source={x:Static loc:LocalizationManager.Instance}}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Visibility="{Binding IsHomeEditMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding [Home.ShortcutsHint], Source={x:Static loc:LocalizationManager.Instance}}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{Binding HomeLayoutStatusText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Button Content="{Binding HomeLayoutModeLabel}"
                                Style="{StaticResource SurfaceButtonStyle}"
                                Padding="10,6"
                                Command="{Binding ToggleHomeEditModeCommand}" />
                        <Button Content="{Binding [Home.Layout.Reset], Source={x:Static loc:LocalizationManager.Instance}}"
                                Style="{StaticResource SurfaceButtonStyle}"
                                Padding="10,6"
                                Margin="6,0,0,0"
                                Command="{Binding ResetHomeTileLayoutCommand}"
                                Visibility="{Binding IsHomeEditMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding VisibleHomeTiles}"
                                      Visibility="{Binding IsHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="controls:HomeTileGridPanel.ColumnSpan" Value="{Binding ColumnSpan}" />
                                    <Setter Property="controls:HomeTileGridPanel.RowSpan" Value="{Binding RowSpan}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:HomeTileGridPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid controls:HomeTileDragDropBehavior.IsDragDropEnabled="{Binding DataContext.IsHomeEditMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                          controls:HomeTileDragDropBehavior.ReorderCommand="{Binding DataContext.ReorderHomeTileCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button Command="{Binding DataContext.LaunchTileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TileButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsHomeEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <controls:RoundedClipBorder Grid.RowSpan="2"
                                                                            CornerRadius="18"
                                                                            ClipToBounds="True"
                                                                            IsHitTestVisible="False">
                                                    <controls:RoundedClipBorder.Style>
                                                        <Style TargetType="controls:RoundedClipBorder">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsMusicTile}" Value="True" />
                                                                        <Condition Binding="{Binding DataContext.HasCurrentTrack, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:RoundedClipBorder.Style>
                                                    <Image Source="{Binding DataContext.CurrentTrackArtwork, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Opacity="0.88" />
                                                </controls:RoundedClipBorder>
                                                <Border Grid.RowSpan="2"
                                                        CornerRadius="18"
                                                        Background="#59070B12"
                                                        IsHitTestVisible="False">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsMusicTile}" Value="True" />
                                                                        <Condition Binding="{Binding DataContext.HasCurrentTrack, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Viewbox Width="190"
                                                         Height="190"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         Margin="0,0,-12,-12"
                                                         IsHitTestVisible="False"
                                                         OpacityMask="{StaticResource DiagonalLogoFade}">
                                                    <Viewbox.Style>
                                                        <Style TargetType="Viewbox">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
